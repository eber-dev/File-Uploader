<%
    console.log('\n🎨 [VISTA index.ejs] PASO 1: Renderizando la vista principal');
    console.log('   👤 Usuario:', user?.username || 'sin usuario');
    console.log('   📁 Carpetas recibidas:', folders?.length ?? 0);
    console.log('   📄 Archivos recibidos:', files?.length ?? 0);
    console.log('   📂 Carpeta actual:', currentFolder?.name || 'raíz');
    console.log('   ℹ️ error:', error || 'ninguno');
    console.log('   ℹ️ success:', success || 'ninguno');
%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mi unidad | File Uploader</title>
    <style>
        :root {
            --bg: #eef2f7;
            --panel: #ffffff;
            --text: #1f2937;
            --muted: #64748b;
            --border: #e2e8f0;
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --danger: #dc2626;
            --danger-dark: #b91c1c;
            --success-bg: #ecfdf5;
            --success-text: #047857;
            --error-bg: #fef2f2;
            --error-text: #dc2626;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
            background: var(--bg);
            color: var(--text);
        }

        a {
            color: var(--primary);
            text-decoration: none;
        }

        a:hover {
            text-decoration: underline;
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 1rem 1.5rem;
            background: #ffffff;
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .brand {
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--text);
        }

        .brand:hover {
            text-decoration: none;
        }

        .user {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            color: var(--muted);
            font-size: 0.95rem;
        }

        .container {
            width: 100%;
            max-width: 1100px;
            margin: 0 auto;
            padding: 1.5rem;
            display: grid;
            gap: 1.25rem;
        }

        .breadcrumb {
            font-size: 0.95rem;
            color: var(--muted);
        }

        .breadcrumb span {
            color: var(--text);
            font-weight: 700;
        }

        .alert {
            padding: 0.85rem 1rem;
            border-radius: 10px;
            font-weight: 600;
        }

        .alert.error {
            background: var(--error-bg);
            color: var(--error-text);
        }

        .alert.success {
            background: var(--success-bg);
            color: var(--success-text);
        }

        .panel {
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 1.25rem;
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
        }

        .panel h2 {
            margin: 0 0 1rem;
            font-size: 1.1rem;
        }

        .upload-form,
        .folder-form {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            align-items: center;
        }

        input[type='file'],
        input[type='text'],
        select {
            padding: 0.65rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 0.95rem;
            background: #ffffff;
            color: var(--text);
        }

        input[type='file'] {
            flex: 1 1 240px;
        }

        input[type='text'] {
            flex: 1 1 240px;
        }

        button,
        .button {
            display: inline-block;
            padding: 0.65rem 1rem;
            border: 0;
            border-radius: 8px;
            background: var(--primary);
            color: #ffffff;
            font-size: 0.95rem;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
        }

        button:hover,
        .button:hover {
            background: var(--primary-dark);
            text-decoration: none;
        }

        button.danger,
        .button.danger {
            background: var(--danger);
        }

        button.danger:hover,
        .button.danger:hover {
            background: var(--danger-dark);
        }

        button.small,
        .button.small {
            padding: 0.45rem 0.7rem;
            font-size: 0.85rem;
        }

        .folder-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
            gap: 0.9rem;
        }

        .folder-card {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            padding: 0.9rem;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: #f8fafc;
        }

        .folder-link {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            color: var(--text);
        }

        .folder-link:hover {
            text-decoration: none;
        }

        .folder-icon {
            font-size: 1.6rem;
        }

        .folder-name {
            font-weight: 700;
            overflow-wrap: anywhere;
        }

        .folder-meta {
            color: var(--muted);
            font-size: 0.85rem;
        }

        .table-wrap {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.95rem;
        }

        th,
        td {
            padding: 0.8rem 0.6rem;
            border-bottom: 1px solid var(--border);
            text-align: left;
            vertical-align: middle;
        }

        th {
            color: var(--muted);
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .file-name {
            font-weight: 600;
            overflow-wrap: anywhere;
        }

        .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            align-items: center;
        }

        .actions form {
            margin: 0;
        }

        .empty {
            margin: 0;
            color: var(--muted);
        }

        @media (max-width: 640px) {
            .topbar {
                align-items: flex-start;
                flex-direction: column;
            }

            .user {
                width: 100%;
                justify-content: space-between;
            }

            .container {
                padding: 1rem;
            }
        }
    </style>
</head>
<body>
    <%
        function formatBytes(bytes) {
            if (!bytes || bytes === 0) {
                return '0 B';
            }

            const units = ['B', 'KB', 'MB', 'GB', 'TB'];
            const index = Math.min(
                Math.floor(Math.log(bytes) / Math.log(1024)),
                units.length - 1,
            );
            const value = bytes / Math.pow(1024, index);

            return `${value.toFixed(value >= 10 || index === 0 ? 0 : 1)} ${units[index]}`;
        }

        function fileIcon(mimeType) {
            if (!mimeType) return '📄';
            if (mimeType.startsWith('image/')) return '🖼️';
            if (mimeType.startsWith('video/')) return '🎬';
            if (mimeType.startsWith('audio/')) return '🎵';
            if (mimeType.includes('pdf')) return '📕';
            if (mimeType.includes('zip') || mimeType.includes('compressed')) {
                return '🗜️';
            }
            return '📄';
        }
    %>

    <header class="topbar">
        <a class="brand" href="/">📁 Mi unidad</a>

        <div class="user">
            <span>
                👤 <%= user?.username || user?.name || user?.email || 'Usuario' %>
            </span>

            <form method="POST" action="/auth/logout">
                <button type="submit" class="danger small">Cerrar sesión</button>
            </form>
        </div>
    </header>

    <main class="container">
        <% if (currentFolder) { %>
        <nav class="breadcrumb">
            <a href="/">Mi unidad</a> / <span><%= currentFolder.name %></span>
        </nav>
        <% } %>

        <% if (error) { %>
        <div class="alert error"><%= error %></div>
        <% } %>

        <% if (success) { %>
        <div class="alert success"><%= success %></div>
        <% } %>

        <section class="panel">
            <h2>Subir archivo</h2>

            <form
                class="upload-form"
                method="POST"
                action="/upload"
                enctype="multipart/form-data"
            >
                <input type="file" name="file" required />

                <% if (currentFolder) { %>
                <input
                    type="hidden"
                    name="folderId"
                    value="<%= currentFolder.id %>"
                />
                <% } else if (folders.length > 0) { %>
                <select name="folderId">
                    <option value="">Mi unidad (raíz)</option>
                    <% folders.forEach((folder) => { %>
                    <option value="<%= folder.id %>"><%= folder.name %></option>
                    <% }); %>
                </select>
                <% } %>

                <button type="submit">Subir archivo</button>
            </form>
        </section>

        <% if (!currentFolder) { %>
        <section class="panel">
            <h2>Crear carpeta</h2>

            <form class="folder-form" method="POST" action="/folders">
                <input
                    type="text"
                    name="name"
                    placeholder="Nombre de la carpeta"
                    required
                />
                <button type="submit">Crear carpeta</button>
            </form>
        </section>

        <section class="panel">
            <h2>Carpetas</h2>

            <% if (folders.length === 0) { %>
            <p class="empty">No hay carpetas todavía.</p>
            <% } else { %>
            <div class="folder-grid">
                <% folders.forEach((folder) => { %>
                <article class="folder-card">
                    <a class="folder-link" href="/folders/<%= folder.id %>">
                        <span class="folder-icon">📁</span>
                        <span class="folder-name"><%= folder.name %></span>
                        <span class="folder-meta">
                            <%= folder._count?.files || 0 %> archivo(s)
                        </span>
                    </a>

                    <form
                        method="POST"
                        action="/folders/<%= folder.id %>/delete"
                        onsubmit="return confirm('¿Eliminar esta carpeta? Los archivos quedarán en la raíz.');"
                    >
                        <button type="submit" class="danger small">
                            Eliminar
                        </button>
                    </form>
                </article>
                <% }); %>
            </div>
            <% } %>
        </section>
        <% } %>

        <section class="panel">
            <h2>
                <%= currentFolder ? 'Archivos en "' + currentFolder.name + '"' : 'Archivos' %>
            </h2>

            <% if (files.length === 0) { %>
            <p class="empty">No hay archivos todavía.</p>
            <% } else { %>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Archivo</th>
                            <th>Tipo</th>
                            <th>Tamaño</th>
                            <th>Subido</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% files.forEach((file) => { %>
                        <tr>
                            <td class="file-name">
                                <span><%= fileIcon(file.mimeType) %></span>
                                <%= file.name %>
                            </td>
                            <td><%= file.mimeType %></td>
                            <td><%= formatBytes(file.size) %></td>
                            <td>
                                <%= new Date(file.createdAt).toLocaleDateString('es-ES') %>
                            </td>
                            <td class="actions">
                                <a
                                    class="button small"
                                    href="/files/<%= file.id %>/download"
                                >
                                    Descargar
                                </a>

                                <form
                                    method="POST"
                                    action="/files/<%= file.id %>/delete"
                                    onsubmit="return confirm('¿Eliminar este archivo?');"
                                >
                                    <button
                                        type="submit"
                                        class="danger small"
                                    >
                                        Eliminar
                                    </button>
                                </form>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <% } %>
        </section>
    </main>
</body>
</html>
